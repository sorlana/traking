<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /traking/

    # Запрет прямого доступа к служебным папкам
    RewriteRule ^(app|config|database|storage|views)(/|$) - [F,L]

    # Если запрос к реальному файлу (CSS, JS, картинки в public/) — отдаём
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Всё остальное — на public/index.php (включая корень и все маршруты)
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>
