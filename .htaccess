<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /traking/

    # Если запрос к реальному файлу в public/ — отдаём напрямую
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Всё остальное — на public/index.php
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>

# Запрет прямого доступа к app/, config/, database/, storage/
<IfModule mod_rewrite.c>
    RewriteRule ^(app|config|database|storage|views)/ - [F,L]
</IfModule>
