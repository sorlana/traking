<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /traking/

    # PWA, Service Worker и Web Push работают только в secure context.
    # Канонизируем весь проект на HTTPS до внутренних rewrite-правил.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://unique-style.ru%{REQUEST_URI} [R=301,L,NE]

    # Запрет прямого доступа к служебным папкам
    RewriteRule ^(app|config|database|storage|views|\.osp|\.git|\.github|\.kiro|\.agents)(/|$) - [F,L]

    # Запрет доступа к скрытым файлам (.*) в корне проекта
    RewriteRule (^|/)\. - [F,L]

    # Публичная статика хранится в public/, но доступна без /public в URL.
    # Явные правила не зависят от DOCUMENT_ROOT хостинга.
    RewriteRule ^(assets|icons)/(.*)$ public/$1/$2 [L]
    RewriteRule ^(manifest\.json|favicon\.svg|service-worker\.js|offline\.html)$ public/$1 [L]

    # Если запрос к реальному файлу в public/ — отдаём его оттуда
    RewriteCond %{DOCUMENT_ROOT}/traking/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]

    # Всё остальное — на public/index.php (включая корень и все маршруты)
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>

# Запрет доступа к файлам конфигурации, миграций и документации в корне
<FilesMatch "\.(ini|sql|md|yml|yaml|log|env|bak|dist)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
